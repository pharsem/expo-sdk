{
    "name": "pharsem/expo-sdk",
    "description": "A modern, dependency-free PHP SDK for the Expo push notification service.",
    "keywords": ["expo", "push", "notifications", "expo-push", "react-native", "sdk"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/pharsem/expo-sdk",
    "support": {
        "issues": "https://github.com/pharsem/expo-sdk/issues",
        "source": "https://github.com/pharsem/expo-sdk"
    },
    "authors": [
        {
            "name": "Petter G. Harsem",
            "homepage": "https://github.com/pharsem"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1"
    },
    "suggest": {
        "ext-zlib": "Compresses large request bodies with gzip before sending.",
        "psr/http-client": "Sends requests through any PSR-18 client, such as Guzzle, with Psr18HttpClient."
    },
    "autoload": {
        "psr-4": {
            "Expo\\Push\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Expo\\Push\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
